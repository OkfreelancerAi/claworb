# Copy to .env.local or set environment variables in your hosting provider (Vercel, Fly, etc.). Never commit real credentials.
# Paid routes remain disabled unless every required value is correctly configured.

# Who receives paid USDC (0x... address on EVM chains). Must match your owner lock for fully-locked owner flows.
# For production mainnet launch set this to the verified owner address (ClawOrb ownership lock).
X402_PAY_TO=0xYOUR_RECIPIENT_ADDRESS_HERE

# x402 facilitator endpoint (https://...). Use the production facilitator URL you were provided.
X402_FACILITATOR_URL=https://facilitator.example

# Base mainnet RPC (HTTPS). Must support eth_getTransactionReceipt and log queries.
# Recommended: use a managed RPC provider with good uptime and archive support if needed.
BASE_RPC_URL=https://base.rpc.provider

# Postgres / Supabase connection string
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Optional: set to false only if your database provider does not require TLS.
DATABASE_SSL=true

# Optional: if you deploy the OwnershipAttestation contract, set its address for dashboard links and verification
OWNERSHIP_ATTESTATION_ADDRESS=

# Runtime / deploy flags
NODE_ENV=production

# Vercel notes:
# - Add each of the variables above to your Project > Settings > Environment Variables in Vercel.
# - For secrets, use Environment Variable type 'Encrypted' (default).
# - Do not include private keys or wallets in these variables. X402_PAY_TO should be a recipient address only.

# Quick mainnet readiness checklist:
# 1. X402_PAY_TO must be set to your verified owner address (see src/lib/config.ts OWNER_LOCK)
# 2. X402_FACILITATOR_URL must point to an approved x402 facilitator (https)
# 3. BASE_RPC_URL must be a reliable Base mainnet RPC (e.g., provided by Alchemy/Infura/Ankr)
# 4. DATABASE_URL must point to a production Postgres/Supabase instance with proper backups
